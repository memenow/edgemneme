{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "edgemneme-memory-gateway",
  "main": "../workers/memory-gateway/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "secrets": {
    "required": ["TOKEN_DIGEST_PEPPER", "PAGE_TOKEN_HMAC_KEY"]
  },
  "ratelimits": [
    {
      "name": "MCP_EDGE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "MCP_CLIENT_LIMITER",
      "namespace_id": "10002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MCP_PRINCIPAL_LIMITER",
      "namespace_id": "10003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "MEMORY_DB",
      "database_name": "edgemneme-memory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    },
    {
      "binding": "SEARCH_DB",
      "database_name": "edgemneme-search",
      "database_id": "11111111-1111-1111-1111-111111111111",
      "migrations_dir": "../migrations/search"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROJECTIONS",
      "bucket_name": "edgemneme-projections"
    }
  ],
  "vectorize": [
    {
      "binding": "MEMORY_VECTORS",
      "index_name": "edgemneme-memory"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_COORDINATOR",
        "class_name": "ProjectCoordinator",
        "script_name": "edgemneme-memory-orchestrator"
      }
    ]
  }
}
